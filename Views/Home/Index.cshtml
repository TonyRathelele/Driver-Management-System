@{
    ViewData["Title"] = "Home";
}

@* 
    Move these two <link> tags to _Layout.cshtml's <head> if this page isn't the only
    one using them, so fonts/icons don't get re-requested on every navigation.
*@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    .dms-page {
        --asphalt: #0B1F33;
        --asphalt-soft: #16293F;
        --route-amber: #057aff;
        --route-amber-dim: #057aff;
        --paper: #F5F6F2;
        --paper-dim: #C7CDD6;
        --slate: #3A4A5C;
        --font-display: 'Oswald', sans-serif;
        --font-body: 'Inter', sans-serif;
        color: var(--paper);
        font-family: var(--font-body);
    }

    .dms-page h1, .dms-page h2, .dms-page h3, .dms-page .dms-display {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    /* ---------- Hero ---------- */
.dms-hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    background-color: var(--asphalt);
    background-image:
    linear-gradient(180deg, rgba(71, 81, 91, 0.55) 0%, rgba(59, 61, 63, 0.55) 55%, rgba(71, 81, 91, 0.55) 100%),
        url('https://images.unsplash.com/photo-1591419478162-a4dd21b7ec0a?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTJ8fHRyYW5zcG9ydGF0aW9uJTIwbG9naXN0aWNzfGVufDB8fDB8fHww');
    background-size: cover;
    background-position: center;
    overflow: hidden;
}

    /* Road-marking signature motif: a dashed lane line running across the hero */
    .dms-laneline {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 12%;
        height: 6px;
        background-image: repeating-linear-gradient(
            90deg,
            var(--route-amber) 0px,
            var(--route-amber) 46px,
            transparent 46px,
            transparent 84px
        );
        opacity: 0.85;
        transform: skewY(-1.2deg);
    }

    .dms-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: var(--font-display);
        font-size: 0.8rem;
        letter-spacing: 0.18em;
        color: var(--route-amber);
        border: 1px solid rgba(231, 237, 246, 0.5);
        border-radius: 999px;
        padding: 0.35rem 0.9rem;
        margin-bottom: 1.5rem;
    }

    .dms-hero h1 {
        font-size: clamp(2.4rem, 5vw, 4rem);
        line-height: 1.05;
        font-weight: 700;
        max-width: 16ch;
    }

    .dms-hero .lead {
        font-family: var(--font-body);
        color: var(--paper-dim);
        font-size: 1.15rem;
        max-width: 46ch;
        margin-top: 1.25rem;
    }
    .dms-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    padding: 1.5rem 2rem;
}

    .btn-route {
        font-family: var(--font-display);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background-color: var(--route-amber);
        border: 1px solid var(--route-amber);
        color: var(--asphalt);
        font-weight: 600;
        padding: 0.75rem 1.75rem;
        border-radius: 4px;
        transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }
    .btn-route:hover, .btn-route:focus {
        background-color: transparent;
        color: var(--route-amber);
        transform: translateY(-1px);
    }
    .btn-route:focus-visible {
        outline: 2px solid var(--route-amber);
        outline-offset: 3px;
    }

    .btn-route-outline {
        font-family: var(--font-display);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background: transparent;
        border: 1px solid rgba(245,246,242,0.5);
        color: var(--paper);
        font-weight: 600;
        padding: 0.75rem 1.75rem;
        border-radius: 4px;
        transition: border-color 0.15s ease, color 0.15s ease;
    }
    .btn-route-outline:hover, .btn-route-outline:focus {
        border-color: var(--paper);
        color: var(--route-amber);
    }

    /* ---------- Stats strip ---------- */
    .dms-stats {
        background: var(--asphalt-soft);
        border-top: 1px solid rgba(245,246,242,0.08);
        border-bottom: 1px solid rgba(245,246,242,0.08);
    }
    .dms-stats .stat-num {
        font-family: var(--font-display);
        font-size: 2.1rem;
        color: var(--route-amber);
        font-weight: 600;
    }
    .dms-stats .stat-label {
        color: var(--paper-dim);
        font-size: 0.85rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
    }

    /* ---------- Features ---------- */
    .dms-features {
        background: var(--asphalt);
        padding-block: 5rem;
        position: relative;
    }
    .dms-section-title {
        font-size: clamp(1.6rem, 3vw, 2.2rem);
        font-weight: 600;
    }
    .dms-section-sub {
        color: var(--paper-dim);
        max-width: 52ch;
    }

    .dms-card {
        background: var(--asphalt-soft);
        border: 1px solid rgba(245,246,242,0.08);
        border-radius: 10px;
        padding: 2rem 1.6rem;
        height: 100%;
        transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .dms-card:hover {
        border-color: rgba(242,169,0,0.45);
        transform: translateY(-3px);
    }
    .dms-card .icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(242,169,0,0.12);
        color: var(--route-amber);
        font-size: 1.35rem;
        margin-bottom: 1.1rem;
    }
    .dms-card h3 {
        font-size: 1.05rem;
        margin-bottom: 0.5rem;
    }
    .dms-card p {
        color: var(--paper-dim);
        font-size: 0.92rem;
        margin-bottom: 0;
    }

    /* ---------- Footer ---------- */
    .dms-footer {
        background: var(--asphalt-soft);
        border-top: 1px solid rgba(245,246,242,0.08);
        padding: 1.5rem 2rem;
    }
    .dms-footer, .dms-footer a {
        color: var(--paper-dim);
        font-size: 0.9rem;
    }
    .dms-footer a { text-decoration: none; }
    .dms-footer a:hover { color: var(--route-amber); }

    @@media (max-width: 767.98px) {
        .dms-hero { min-height: 100vh; text-align: center; }
        .dms-hero h1 { max-width: none; }
        .dms-hero .lead { margin-inline: auto; }
        .dms-eyebrow { margin-inline: auto; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .dms-card { transition: none; }
        .btn-route, .btn-route-outline { transition: none; }
    }
</style>

<div class="dms-page">
    <header class="dms-header">
    <img src="~/images/logo1.png" alt="Takealot" style="max-width:140px" />
</header>

    <!-- ============ HERO ============ -->
    <section class="dms-hero">
        <div class="dms-laneline" aria-hidden="true"></div>
        <div class="container position-relative py-5">
            <div class="row">
                <div class="col-lg-8">

                    <span class="dms-eyebrow"> Driver Management System</span>

                    <h1>Every route, every driver, one dashboard.</h1>

                    <p class="lead">
                        Manage vacancies, review applications, track vehicles and send driver
                        notifications &mdash; all from a single place built for the road.
                    </p>

                    <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
                        <a class="btn-route" asp-controller="Account" asp-action="Login">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Driver Login
                        </a>
                        <a class="btn-route-outline" href="#vacancies">
                            <i class="bi bi-search me-2"></i>View Open Vacancies
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ STATS ============ -->
    <section class="dms-stats py-4">
        <div class="container">
            <div class="row text-center g-3">
                <div class="col-6 col-md-3">
                    <div class="stat-num">1,200+</div>
                    <div class="stat-label">Active Drivers</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-num">38</div>
                    <div class="stat-label">Open Vacancies</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-num">640</div>
                    <div class="stat-label">Vehicles Tracked</div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="stat-num">24/7</div>
                    <div class="stat-label">Fleet Monitoring</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ FEATURES ============ -->
    <section class="dms-features" id="vacancies">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-7">
                    <div class="dms-section-title mb-2 dms-display">What the system handles</div>
                    <p class="dms-section-sub">
                        Built around the daily rhythm of a driver operation: getting people hired,
                        keeping vehicles road-ready, and making sure nobody misses an update.
                    </p>
                </div>
            </div>

            <div class="row g-4">
                <div class="col-sm-6 col-lg-3">
                    <div class="dms-card">
                        <div class="icon-wrap"><i class="bi bi-signpost-2-fill"></i></div>
                        <h3>Vacancies</h3>
                        <p>Post open driver positions by route, region or vehicle class and manage them from one board.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="dms-card">
                        <div class="icon-wrap"><i class="bi bi-person-check-fill"></i></div>
                        <h3>Applications</h3>
                        <p>Review, shortlist and approve driver applications with a clear status trail from applied to hired.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="dms-card">
                        <div class="icon-wrap"><i class="bi bi-truck"></i></div>
                        <h3>Vehicles</h3>
                        <p>Assign vehicles to drivers, log service dates and keep an eye on what's due for inspection.</p>
                    </div>
                </div>
                <div class="col-sm-6 col-lg-3">
                    <div class="dms-card">
                        <div class="icon-wrap"><i class="bi bi-bell-fill"></i></div>
                        <h3>Notifications</h3>
                        <p>Push shift changes, compliance reminders and route updates straight to a driver's phone.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="dms-footer d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div>&copy; @DateTime.Now.Year Takealot. All rights reserved.</div>
        <div class="d-flex gap-3">
            <a href="#">Privacy</a>
            <a href="#">Support</a>
            <a asp-controller="Account" asp-action="Login">Driver Login</a>
        </div>
    </footer>

</div>
