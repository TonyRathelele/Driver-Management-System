@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TakealotDriverManagementSystem.Data
@using TakealotDriverManagementSystem.Models
@inject UserManager<User> _userManager
@inject ApplicationDbContext _context
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Takealot Driver</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/driver.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" />
    <style>
        :root {
            --asphalt: #0B1F33;
            --asphalt-soft: #16293F;
            --asphalt-softer: #1E3450;
            --route-amber: #F2A900;
            --paper: #F5F6F2;
            --paper-dim: #C7CDD6;
            --font-display: 'Oswald', sans-serif;
            --font-body: 'Inter', sans-serif;
        }

        body {
            font-family: var(--font-body);
            background: #EEF1F4;
            margin: 0;
        }

        .dashboard-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* ---------- Sidebar ---------- */
        .sidebar {
            width: 260px;
            flex-shrink: 0;
            background: var(--asphalt);
            display: flex;
            flex-direction: column;
            transition: width 0.2s ease;
        }
        .sidebar-header {
            padding: 1.5rem 1.25rem;
            border-bottom: 1px solid rgba(245,246,242,0.08);
        }
        .sidebar-header .full-logo { max-width: 150px; }
        .sidebar-header .collapsed-logo { display: none; max-width: 34px; }

        .sidebar-nav {
            list-style: none;
            margin: 0;
            padding: 0.75rem 0;
            flex: 1;
        }
        .sidebar-nav-item { margin: 0.15rem 0.75rem; }
        .sidebar-nav-link {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.7rem 0.9rem;
            border-radius: 6px;
            color: var(--paper-dim);
            text-decoration: none;
            font-size: 0.92rem;
            font-family: var(--font-display);
            letter-spacing: 0.03em;
            text-transform: uppercase;
            font-weight: 500;
            transition: background-color 0.15s ease, color 0.15s ease;
        }
        .sidebar-nav-link i {
            width: 20px;
            text-align: center;
            color: var(--paper-dim);
            font-size: 0.95rem;
            transition: color 0.15s ease;
        }
        .sidebar-nav-link:hover {
            background: var(--asphalt-soft);
            color: var(--paper);
        }
        .sidebar-nav-link:hover i { color: var(--route-amber); }
        .sidebar-nav-item.active .sidebar-nav-link {
            background: var(--asphalt-soft);
            color: var(--route-amber);
            border-left: 3px solid var(--route-amber);
        }
        .sidebar-nav-item.active .sidebar-nav-link i { color: var(--route-amber); }

        /* ---------- Content area ---------- */
        .content-area {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .top-navbar {
            height: 68px;
            background: #fff;
            border-bottom: 1px solid #E3E7EC;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.75rem;
        }
        .navbar-title {
            font-family: var(--font-display);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-size: 1.1rem;
            color: var(--asphalt);
        }
        .navbar-icons-right {
            display: flex;
            align-items: center;
        }
        .navbar-icons-right a {
            color: var(--asphalt) !important;
            transition: color 0.15s ease;
        }
        .navbar-icons-right a:hover { color: var(--route-amber) !important; }
        .navbar-icons-right .badge {
            background-color: var(--route-amber) !important;
            color: var(--asphalt);
            font-family: var(--font-body);
            font-size: 0.65rem;
        }

        .main-dashboard-content {
            padding: 2rem;
            flex: 1;
        }

        @@media (max-width: 991.98px) {
            .sidebar { width: 74px; }
            .sidebar-header .full-logo { display: none; }
            .sidebar-header .collapsed-logo { display: block; }
            .sidebar-nav-link .menu-text { display: none; }
            .sidebar-nav-link { justify-content: center; }
        }
    </style>
</head>
<body>
<div class="dashboard-wrapper" id="dashboardWrapper">
    <aside class="sidebar">
        <div class="sidebar-header">
            <a asp-action="Dashboard" asp-controller="Driver">
                <img src="~/images/takealot-alt-logo.png" alt="Takealot Logo" class="full-logo" />
                <img src="~/images/takealot-icon.png" alt="Takealot Icon" class="collapsed-logo" />
            </a>
        </div>
        <ul class="sidebar-nav">
            <li class="sidebar-nav-item"><a asp-action="Dashboard" asp-controller="Driver" class="sidebar-nav-link"><i class="fas fa-tachometer-alt"></i><span class="menu-text">Dashboard</span></a></li>
            <li class="sidebar-nav-item"><a asp-action="Vacancies" asp-controller="Driver" class="sidebar-nav-link"><i class="fas fa-briefcase"></i><span class="menu-text">Driver Vacancies</span></a></li>
            <li class="sidebar-nav-item"><a asp-action="JobApplications" asp-controller="Driver" class="sidebar-nav-link"><i class="fas fa-file-alt"></i><span class="menu-text">My Applications</span></a></li>
            <li class="sidebar-nav-item"><a asp-action="VehicleDetails" asp-controller="Driver" class="sidebar-nav-link"><i class="fas fa-truck"></i><span class="menu-text">My Vehicle</span></a></li>
            <li class="sidebar-nav-item"><a asp-action="Notifications" asp-controller="Driver" class="sidebar-nav-link"><i class="fas fa-bell"></i><span class="menu-text">Notifications</span></a></li>
            <li class="sidebar-nav-item"><a asp-action="Profile" asp-controller="Driver" class="sidebar-nav-link"><i class="fas fa-user-circle"></i><span class="menu-text">My Profile</span></a></li>
            <li class="sidebar-nav-item"><a asp-action="Logout" asp-controller="Account" class="sidebar-nav-link"><i class="fas fa-sign-out-alt"></i><span class="menu-text">Logout</span></a></li>
        </ul>
    </aside>
    <div class="content-area">
        <nav class="top-navbar">
            <div class="navbar-title">@ViewData["Title"]</div>
            <div class="navbar-icons-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var userId = _userManager.GetUserId(User);
                    var unreadCount = await _context.Notifications.CountAsync(n => n.UserId == userId && !n.IsRead);
                    <a asp-controller="Driver" asp-action="Notifications" class="text-decoration-none position-relative me-3">
                        <i class="fas fa-bell fa-lg"></i>
                        @if (unreadCount > 0) { <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">@unreadCount</span> }
                    </a>
                }
                <a asp-controller="Driver" asp-action="Profile"><i class="fas fa-user-circle fa-2x"></i></a>
            </div>
        </nav>
        <main class="main-dashboard-content">
            @RenderBody()
        </main>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>