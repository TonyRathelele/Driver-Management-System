@model DriverDashboardViewModel
@{
    ViewData["Title"] = "Driver Dashboard";
    Layout = "_DriverLayout";
}
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Welcome, @Model.User.FirstName!</h1>
            <p class="text-muted mb-0">Here is your driver overview.</p>
        </div>
        <a asp-action="Vacancies" class="btn btn-primary"><i class="fas fa-search me-2"></i>Find Vacancies</a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5><i class="fas fa-id-card me-2"></i>Driver Details</h5>
                    <hr />
                    <p class="mb-1"><strong>Name:</strong> @Model.User.FirstName @Model.User.LastName</p>
                    <p class="mb-1"><strong>License:</strong> @Model.Driver?.LicenseNumber</p>
                    <p class="mb-0"><strong>Contact:</strong> @Model.User.ContactNumber</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5><i class="fas fa-truck me-2"></i>Assigned Vehicle</h5>
                    <hr />
                    @if (Model.Driver?.AssignedVehicle != null)
                    {
                        <p class="mb-1"><strong>Vehicle:</strong> @Model.Driver.AssignedVehicle.Make @Model.Driver.AssignedVehicle.Model</p>
                        <p class="mb-1"><strong>Plate:</strong> @Model.Driver.AssignedVehicle.LicensePlate</p>
                        <p class="mb-0"><strong>Warehouse:</strong> @Model.Driver.AssignedVehicle.Warehouse?.Name</p>
                    }
                    else
                    {
                        <p class="text-muted">No vehicle assigned.</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5><i class="fas fa-bell me-2"></i>Unread Notifications</h5>
                    <hr />
                    <div class="display-5">@Model.Notifications.Count</div>
                    <a asp-action="Notifications" class="btn btn-outline-primary mt-2">View Notifications</a>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Notifications.Any())
    {
        <div class="card shadow-sm mt-4">
            <div class="card-header"><strong>Recent Notifications</strong></div>
            <div class="list-group list-group-flush">
                @foreach (var notification in Model.Notifications)
                {
                    <a asp-action="NotificationDetails" asp-route-id="@notification.Id" class="list-group-item list-group-item-action">
                        <div class="d-flex justify-content-between">
                            <span>@Html.Raw(notification.Message)</span>
                            <small class="text-muted">@notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>
