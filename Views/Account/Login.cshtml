@{
    ViewData["Title"] = "Driver Login";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    .login-page {
        --asphalt: #0B1F33;
        --route-amber: #057aff;
        --route-amber-dim: #057aff;
        --paper: #F5F6F2;
        --paper-dim: #C7CDD6;
        --font-display: 'Oswald', sans-serif;
        --font-body: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        font-family: var(--font-body);
        background: var(--asphalt);
    }

    .login-page h1, .login-page h2, .login-page .login-display {
        font-family: var(--font-display);
        text-transform: uppercase;
        letter-spacing: 0.03em;
    }

    /* ---------- Left: image panel ---------- */
    .login-visual {
        position: relative;
        flex: 1 1 50%;
        display: none;
        background-color: var(--asphalt);
        background-image:
    linear-gradient(180deg, rgba(71, 81, 91, 0.55) 0%, rgba(59, 61, 63, 0.55) 55%, rgba(71, 81, 91, 0.55) 100%),
        url('https://images.unsplash.com/photo-1591419478162-a4dd21b7ec0a?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTJ8fHRyYW5zcG9ydGF0aW9uJTIwbG9naXN0aWNzfGVufDB8fDB8fHww');
        background-size: cover;
        background-position: center;
    }
    .login-visual .login-header {
        position: absolute;
        top: 0;
        left: 0;
        padding: 2rem;
    }
    .login-visual .login-caption {
        position: absolute;
        left: 2rem;
        right: 2rem;
        bottom: 2.5rem;
        color: var(--paper);
    }
    .login-visual .login-caption h1 {
        font-size: clamp(1.6rem, 2.4vw, 2.2rem);
        max-width: 14ch;
    }
    .login-visual .login-caption p {
        color: var(--paper-dim);
        max-width: 34ch;
        margin-top: 0.75rem;
    }
    .login-laneline {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 30%;
        height: 5px;
        background-image: repeating-linear-gradient(
            90deg,
            var(--route-amber) 0px,
            var(--route-amber) 40px,
            transparent 40px,
            transparent 74px
        );
        opacity: 0.8;
        transform: skewY(-1.2deg);
    }

    @@media (min-width: 992px) {
        .login-visual { display: block; }
    }

    /* ---------- Right: form panel ---------- */
    .login-form-panel {
        flex: 1 1 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1.5rem;
    }
    .login-form-inner {
        width: 100%;
        max-width: 400px;
    }
    .login-form-inner .logo-mark {
        max-width: 130px;
        margin-bottom: 2rem;
    }
    .login-eyebrow {
        font-family: var(--font-display);
        font-size: 0.75rem;
        letter-spacing: 0.18em;
        color: var(--route-amber);
        margin-bottom: 0.5rem;
    }
    .login-form-inner h2 {
        color: var(--paper);
        font-size: 1.7rem;
        margin-bottom: 0.4rem;
    }
    .login-sub {
        color: var(--paper-dim);
        font-size: 0.92rem;
        margin-bottom: 2rem;
    }

    .login-page .form-label {
        color: var(--paper-dim);
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        margin-bottom: 0.4rem;
    }
    .login-page .form-control {
        background: var(--asphalt-soft);
        border: 1px solid rgba(245,246,242,0.15);
        color: var(--paper);
        padding: 0.65rem 0.9rem;
        border-radius: 6px;
    }
    .login-page .form-control:focus {
        background: var(--asphalt-soft);
        border-color: var(--route-amber);
        color: var(--paper);
        box-shadow: 0 0 0 3px rgba(242,169,0,0.18);
    }
    .login-page .form-control::placeholder {
        color: rgba(199,205,214,0.5);
    }

    .btn-route {
        font-family: var(--font-display);
        letter-spacing: 0.05em;
        text-transform: uppercase;
        background-color: var(--route-amber);
        border: 1px solid var(--route-amber);
        color: var(--asphalt);
        font-weight: 600;
        padding: 0.75rem 1.75rem;
        border-radius: 6px;
        width: 100%;
        transition: background-color 0.15s ease, color 0.15s ease;
    }
    .btn-route:hover, .btn-route:focus {
        background-color: transparent;
        color: var(--route-amber);
    }
    .btn-route:focus-visible {
        outline: 2px solid var(--route-amber);
        outline-offset: 3px;
    }

    .login-demo-box {
        margin-top: 1.75rem;
        background: var(--asphalt-soft);
        border: 1px dashed rgba(242,169,0,0.4);
        border-radius: 8px;
        padding: 1rem 1.1rem;
        color: var(--paper-dim);
        font-size: 0.85rem;
    }
    .login-demo-box strong {
        color: var(--route-amber);
        font-family: var(--font-display);
        letter-spacing: 0.04em;
        text-transform: uppercase;
        font-size: 0.78rem;
        display: block;
        margin-bottom: 0.4rem;
    }

    .login-page .text-danger {
        font-size: 0.85rem;
    }
</style>

<div class="login-page">

    <!-- ============ LEFT VISUAL PANEL ============ -->
    <div class="login-visual">
        <div class="login-laneline" aria-hidden="true"></div>
        <div class="login-header">
            <img src="~/images/logo1.png" alt="Takealot" style="max-width:130px" />
        </div>
        <div class="login-caption">
            <h1 class="login-display">Back on the road.</h1>
            <p>Sign in to view your shifts, vehicle assignments and the latest driver notifications.</p>
        </div>
    </div>

    <!-- ============ RIGHT FORM PANEL ============ -->
    <div class="login-form-panel">
        <div class="login-form-inner">
            <img src="~/images/logo1.png" alt="Takealot" class="logo-mark d-lg-none" />

            <div class="login-eyebrow">Driver Management System</div>
            <h2>Driver Login</h2>
            <p class="login-sub">Enter your details to access your dashboard.</p>

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input name="email" type="email" class="form-control" value="driver@takealot.local" required />
                </div>
                <div class="mb-4">
                    <label class="form-label">Password</label>
                    <input name="password" type="password" class="form-control" value="Driver123" required />
                </div>

                <button class="btn-route" type="submit">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
                </button>
            </form>

            <div class="login-demo-box">
                <strong>Demo credentials</strong>
                Email: driver@takealot.local<br />
                Password: Driver123
            </div>
        </div>
    </div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
